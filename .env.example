# Copiez ce fichier en ".env" (sans .example) à la racine du projet.

# Fichier SQLite, créé dans le dossier prisma/
DATABASE_URL="file:./dev.db"

# Clé secrète pour supprimer des articles et des commentaires.
# Choisissez une longue phrase. Si elle est absente, la suppression est désactivée.
ADMIN_KEY="remplacez-moi-par-une-longue-phrase-secrete"
